# LiveKit Configuration
VITE_LIVEKIT_URL=wss://ethiocosmos-learning-community-1vp1cr43.livekit.cloud

# These are used by the backend API only (not exposed to frontend)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq Configuration (server-side only; never prefix with VITE_)
GROQ_API_KEY=your_groq_api_key

# Daily Space News server configuration. Keep these out of browser code.
NASA_API_KEY=your_nasa_api_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=your_random_cron_secret
GROQ_MODEL=llama-3.3-70b-versatile

# IMPORTANT: this example file must contain placeholders only. Never commit real credentials.
